# Which AI answers first: "claude" (default) or "gemini". The other one, if it has a key,
# takes over automatically when the first fails (quota, outage, billing, timeout), and the
# visitor is told. Set at least one of the two keys below.
AI_PROVIDER=

# Claude (Anthropic API). The default model is claude-haiku-5-5; effort is low | medium | high.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
# Only for tests: point the app at a local fake of the Claude API.
ANTHROPIC_BASE_URL=

# Gemini (Google AI). The free tier has a small daily quota per model.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_LEVEL=
# Only for tests: point the app at a local fake of the Gemini API.
GEMINI_API_BASE_URL=

# Rate limiting (Upstash Redis, REST credentials from the Upstash console). In production the app refuses
# to run without them, unless RATE_LIMIT_DISABLED=true.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Plans one visitor (IP) may generate per window, and the window in seconds. Defaults: 5 and 3600.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_SECONDS=
# Plans the whole app may generate per UTC day. Past it, visitors get a sample plan. Default: 200.
DAILY_LIMIT=
# "true" runs without rate limiting (local use only).
RATE_LIMIT_DISABLED=

# "true" serves sample plans only: no AI call, no API key and no Redis needed (a safe public demo).
DEMO_MODE=
